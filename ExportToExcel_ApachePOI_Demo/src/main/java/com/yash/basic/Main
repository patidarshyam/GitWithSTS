package com.example;

import org.apache.poi.ss.usermodel.Row;
import org.apache.poi.ss.usermodel.Sheet;
import org.apache.poi.ss.usermodel.Workbook;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;

import java.io.File;
import java.io.FileOutputStream;
import java.io.IOException;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.concurrent.atomic.AtomicLong;

public class Main {

    private static final long START_NUMBER = 9000000000L;
    private static final long END_NUMBER = 9999999999L; // Adjust as needed
    private static final long MAX_FILE_SIZE_BYTES = 100 * 1024 * 1024; // 100 MB (adjust as needed)
    private static final int MAX_ROWS_PER_SHEET = 1048575; // Maximum rows per sheet in Excel
    private static final String OUTPUT_DIR = "src/main/resources/output/";

    public static void main(String[] args) {
        // Create output directory if it doesn't exist
        File directory = new File(OUTPUT_DIR);
        if (!directory.exists()) {
            directory.mkdirs();
        }

        generatePhoneNumbersToExcel(START_NUMBER, END_NUMBER, MAX_FILE_SIZE_BYTES);
    }

    private static void generatePhoneNumbersToExcel(long start, long end, long maxFileSizeBytes) {
        Workbook workbook = new XSSFWorkbook();
        AtomicLong currentWorkbookBytes = new AtomicLong(0);
        AtomicInteger sheetCount = new AtomicInteger(1);
        Sheet currentSheet = workbook.createSheet("Sheet_" + sheetCount.get());
        Row currentRow = null;

        for (long number = start; number <= end; number++) {
            if (currentRow == null || currentRow.getRowNum() > MAX_ROWS_PER_SHEET) {
                if (currentSheet.getLastRowNum() >= 0) {
                    currentSheet = workbook.createSheet("Sheet_" + sheetCount.incrementAndGet());
                    currentRow = null;
                    System.out.println("Created new sheet: " + currentSheet.getSheetName());
                }
            }

            if (currentRow == null) {
                currentRow = currentSheet.createRow((int) currentSheet.getLastRowNum() + 1); // Create new row
            }

            currentRow.createCell(0).setCellValue(number);
            currentWorkbookBytes.addAndGet(Long.SIZE / 8); // Long.SIZE / 8 bytes per number

            if (currentWorkbookBytes.get() >= maxFileSizeBytes) {
                saveWorkbook(workbook, sheetCount.get());
                workbook = new XSSFWorkbook();
                currentWorkbookBytes.set(0);
                sheetCount.set(1);
                currentSheet = workbook.createSheet("Sheet_" + sheetCount.get());
                System.out.println("Created new sheet: " + currentSheet.getSheetName());
            }
        }

        // Save the last workbook
        saveWorkbook(workbook, sheetCount.get());

        System.out.println("Excel files generated successfully in " + OUTPUT_DIR);
    }

    private static void saveWorkbook(Workbook workbook, int sheetCount) {
        String fileName = OUTPUT_DIR + "phone_numbers_" + sheetCount + ".xlsx";
        try (FileOutputStream fileOut = new FileOutputStream(fileName)) {
            workbook.write(fileOut);
            long fileSizeMB = fileOut.getChannel().size() / (1024 * 1024);
            System.out.println("File saved: " + fileName + ", Size: " + fileSizeMB + " MB");
        } catch (IOException e) {
            e.printStackTrace();
        } finally {
            try {
                workbook.close();
            } catch (IOException e) {
                e.printStackTrace();
            }
        }
    }
}
