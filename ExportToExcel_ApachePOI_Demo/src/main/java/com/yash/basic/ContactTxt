package com.example;

import java.io.BufferedWriter;
import java.io.File;
import java.io.FileWriter;
import java.io.IOException;

public class Main {

    private static final long START_NUMBER = 9000000000L;
    private static final long END_NUMBER = 9999999999L;

    public static void main(String[] args) {
        generatePhoneNumbersToFile(START_NUMBER, END_NUMBER);
    }

    private static void generatePhoneNumbersToFile(long start, long end) {
        File outputFile = new File("src/main/resources/output/phone_numbers.txt");

        try (BufferedWriter writer = new BufferedWriter(new FileWriter(outputFile))) {
            for (long number = start; number <= end; number++) {
                writer.write(String.valueOf(number));
                writer.newLine();
            }
            System.out.println("Phone numbers saved to: " + outputFile.getAbsolutePath());
        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
